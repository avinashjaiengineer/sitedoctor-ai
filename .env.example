# ── AI model: pick ONE provider ───────────────────────────────────────────
# Claude: anthropic | vertex | bedrock | foundry.  Others: gemini | azure-openai.
# If unset, inferred from whichever credentials below are present.
# With nothing configured, SiteDoctor uses a rules-based treatment plan instead.
LLM_PROVIDER=
# Optional model override. Defaults: claude-opus-5-5 (Bedrock: anthropic.claude-opus-5-5; Foundry: your deployment name)
# ANTHROPIC_MODEL=

# Anthropic API
ANTHROPIC_API_KEY=

# Google Vertex AI (enable Claude Opus 5.5 in Model Garden first)
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=global
# Service-account key JSON on one line (needed on Vercel; locally `gcloud auth application-default login` works instead)
GOOGLE_CREDENTIALS_JSON=

# Amazon Bedrock (enable model access for Claude Opus 5.5 first).
# Use a Bedrock API key, OR an IAM access key pair. BEDROCK_-prefixed names because Vercel reserves AWS_*.
BEDROCK_AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=

# Microsoft Foundry (Claude on Azure): resource name from https://{resource}.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# Gemini on Google Vertex AI (no Marketplace purchase needed)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-pro
# GOOGLE_CREDENTIALS_JSON above is shared: required on Vercel, optional locally (ADC)

# Azure OpenAI (GPT). Works on free-trial subscriptions.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Google PageSpeed Insights (Lighthouse). Effectively required: keyless requests share a
# global daily quota that is usually exhausted. Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Optional: Upstash Redis for shareable cached reports and rate limiting across serverless instances.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: footer credits and absolute URLs for share images
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_SITE_URL=
